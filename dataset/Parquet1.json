{
	"name": "Parquet1",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"tablename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(toLower(dataset().tablename),'_',formatDateTime(utcNow(),'yyyyMMddHHmmss'),'.parquet')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('raw/',toLower(dataset().tablename),'/',formatDateTime(utcNow(), 'yyyy/MM/dd'))",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}